  surface       #1E2026   Tarjetas, modales
  surfaceAlt    #2B3139   Inputs, fondos secundarios
  border        #2B3139

Acentos:
  primary       #F0B90B   Amarillo Binance (botones principales)

Texto:
  textPrimary   #EAECEF
  textSecondary #848E9C
  textMuted     #5E6673

Estados:
  success       #0ECB81   Verde
  danger        #F6465D   Rojo
  info          #2E8DEF   Azul

Colores por tipo de gasto:
  colorFijo     #1890FF   Azul
  colorNoFijo   #F0B90B   Amarillo (variable)
  colorAhorro   #0ECB81   Verde

================================================================================
10. BACKEND - ENDPOINTS REST
================================================================================

Base URL: https://presupuestos-backend-h3l6.onrender.com

────────────────────────────────────────────────────────
10.1 PRESUPUESTOS
────────────────────────────────────────────────────────
GET /presupuestos?firebase_uid=xxx
  Retorna: array con campos basicos del presupuesto
  CAMPOS DISPONIBLES: id, nombre, monto_total, firebase_uid,
                      tipo_periodo, dia_inicio_periodo
  CAMPOS NO DISPONIBLES: gastado, disponible, fecha_inicio, fecha_fin
  → Para obtener gastado real usar GET /presupuestos/:id/detalle

GET /presupuestos/:id/detalle?firebase_uid=xxx
  Retorna:
    {
      periodo: { id, fecha_inicio, fecha_fin, estado },
      movimientos: [{ id, descripcion, monto, tipo, pagado, monto_pagado_real }],
      resumen: { totalFijo, totalNoFijo, totalAhorro, totalGastado, porcentajePagados }
    }
  NOTA: totalGastado = suma de m.monto (montos presupuestados, no lo pagado real)
  Para gastado real: SUM(monto_pagado_real) WHERE pagado=1 desde movimientos

GET /presupuestos/:id/historico?firebase_uid=xxx
  Ultimos 6 periodos.
  Retorna: { monto_total, periodos: [{ total_gastado, movimientos_pagados, ... }] }
  NOTA: En historico si, total_gastado = SUM(monto_pagado_real) (el real)

POST /presupuestos
PUT /presupuestos/:id

────────────────────────────────────────────────────────
10.2 GASTOS Y MOVIMIENTOS
────────────────────────────────────────────────────────
POST /gastos
POST /gastos/ahorroMeta
GET /presupuestos/:id/gastos?firebase_uid=xxx
GET /presupuestos/:id/gastos-seleccionables?firebase_uid=xxx
PUT /gastos/:id
PUT /presupuestos/:id/gastos/reanudar-fijos
DELETE /gastos/:id?firebase_uid=xxx
POST /presupuestos/:id/movimientos
PUT /movimientos/:id/pagar   Body: { pagado, monto_pagado_real, firebase_uid }

────────────────────────────────────────────────────────
10.3 AHORROS
────────────────────────────────────────────────────────
GET /ahorros?firebase_uid=xxx
  Retorna: [{ id, nombre, monto_meta, monto_ahorrado, total_aportaciones }]
  CAMPOS EXACTOS:
    nombre           → descripcion del gasto de ahorro
    monto_meta       → meta total (NO se llama 'monto')
    monto_ahorrado   → suma de monto_pagado_real de movimientos pagados
    total_aportaciones → suma de aportaciones manuales adicionales
  TOTAL REAL AHORRADO = monto_ahorrado + total_aportaciones

POST /ahorros/:id/aportaciones
GET /ahorros/:id/aportaciones?firebase_uid=xxx
DELETE /aportaciones/:id?firebase_uid=xxx
DELETE /ahorros/:id?firebase_uid=xxx

────────────────────────────────────────────────────────
10.4 CALENDARIO
────────────────────────────────────────────────────────
GET /calendario/eventos?firebase_uid=xxx&mes=M&anio=A
  Retorna: [{ id, titulo, tipo, fecha_evento, monto_esperado, estado }]
  tipo: 'pago' (gasto) o 'cobro' (ingreso de venta)
  estado: 'pendiente' | 'pagado' | 'cobrado' | 'vencido'

PUT /calendario/eventos/:id/estado
DELETE /calendario/eventos/:id?firebase_uid=xxx&solo_este=true|false

────────────────────────────────────────────────────────
10.5 VENTAS Y COBROS
────────────────────────────────────────────────────────
GET /ventas?firebase_uid=xxx
  Retorna: v.* + total_cobrado, total_esperado, cobros_pendientes
  total_cobrado = SUM(cobros_clientes.monto_cobrado WHERE estado='cobrado')
  NOTA: ventas.estado puede ser 'activa', filtrarlo en Flutter si es necesario

GET /ventas/:id?firebase_uid=xxx → detalle completo con metricas
POST /ventas
PUT /ventas/:id
DELETE /ventas/:id?firebase_uid=xxx
POST /ventas/:id/cobros
PUT /cobros/:id/cobrar
DELETE /cobros/:id?firebase_uid=xxx
GET /ventas/:id/lista-compras?firebase_uid=xxx

────────────────────────────────────────────────────────
10.6 PRESUPUESTOS COMPARTIDOS
────────────────────────────────────────────────────────
GET  /shared-budgets?firebase_uid=xxx
GET  /shared-budgets/:id?firebase_uid=xxx
POST /shared-budgets
POST /shared-budgets/:id/invitations
GET  /shared-budget-invitations?firebase_uid=xxx
POST /shared-budget-invitations/:token/accept
POST /shared-budget-invitations/:token/reject

GET  /shared-budgets/:id/expenses?firebase_uid=xxx        [ACTUALIZADO]
  Retorna campos adicionales:
    mi_parte_pagada  → 1 si yo pague mi parte (pagado_por=yo OR shared_expense_splits.pagado=1)
    su_parte_pagada  → 1 si el otro pago su parte (pagado_por=otro OR otro_split.pagado=1)
    mi_responsabilidad → monto que me corresponde pagar

POST /shared-budgets/:id/expenses
DELETE /shared-expenses/:id?firebase_uid=xxx

POST /shared-expenses/:id/confirm-payment                 [NUEVO]
  Body: { firebase_uid }
  Funcion: marca shared_expense_splits.pagado=1 para el usuario
  Verifica que el usuario sea miembro del presupuesto
  Respuesta 200: { message: 'Pago confirmado' }

POST /shared-budgets/:id/settlements
GET  /shared-budgets/:id/settlements?firebase_uid=xxx

POST /shared-budgets/:id/request-delete                   [NUEVO]
  Body: { firebase_uid }
  Funcion: guarda firebase_uid en shared_budgets.delete_requested_by
  El presupuesto no se elimina aun. El otro usuario debe aprobar.
  Respuesta 200: { message: 'Solicitud de eliminacion enviada' }

────────────────────────────────────────────────────────
10.7 PRODUCTOS, RECETAS, PRODUCCION
────────────────────────────────────────────────────────
(Sin cambios, ver version anterior del documento)


    monto_acordado, porcentaje, horas_trabajadas, tarifa_hora, monto_calculado
    FK: job_id → jobs(id) ON DELETE CASCADE
  customer_payments     → pagos recibidos del cliente
    id, job_id, firebase_uid, monto, tipo ENUM(anticipo|pago_parcial|pago_final),
    nota, fecha_pago
    FK: job_id → jobs(id) ON DELETE CASCADE
  team_member_payments  → pagos realizados a colaboradores
    id, job_id, team_member_id, firebase_uid, monto, nota, fecha_pago
    FK: job_id → jobs(id) ON DELETE CASCADE
    FK: team_member_id → job_team_members(id) ON DELETE CASCADE
  operational_expenses  → gastos operativos del trabajo
    id, job_id, firebase_uid, descripcion, monto, categoria, fecha_gasto
    FK: job_id → jobs(id) ON DELETE CASCADE
  job_activity_logs     → historial de acciones del trabajo
    id, job_id, firebase_uid, accion, detalle, created_at
    FK: job_id → jobs(id) ON DELETE CASCADE

MIGRACION EJECUTADA (2026-05-11 sesion 2):

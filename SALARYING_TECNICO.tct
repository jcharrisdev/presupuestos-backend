POST /shared-budget-invitations/:token/reject

GET  /shared-budgets/:id/expenses?firebase_uid=xxx        [ACTUALIZADO]
  Retorna campos adicionales:
    mi_parte_pagada  → 1 si yo pague mi parte (pagado_por=yo OR shared_expense_splits.pagado=1)
    su_parte_pagada  → 1 si el otro pago su parte (pagado_por=otro OR otro_split.pagado=1)
    mi_responsabilidad → monto que me corresponde pagar

POST /shared-budgets/:id/expenses
DELETE /shared-expenses/:id?firebase_uid=xxx

POST /shared-expenses/:id/confirm-payment                 [NUEVO]
  Body: { firebase_uid }
  Funcion: marca shared_expense_splits.pagado=1 para el usuario
  Verifica que el usuario sea miembro del presupuesto
  Respuesta 200: { message: 'Pago confirmado' }

POST /shared-budgets/:id/settlements
GET  /shared-budgets/:id/settlements?firebase_uid=xxx

POST /shared-budgets/:id/request-delete                   [NUEVO]
  Body: { firebase_uid }
  Funcion: guarda firebase_uid en shared_budgets.delete_requested_by
  El presupuesto no se elimina aun. El otro usuario debe aprobar.
  Respuesta 200: { message: 'Solicitud de eliminacion enviada' }

────────────────────────────────────────────────────────
10.7 PRODUCTOS, RECETAS, PRODUCCION
────────────────────────────────────────────────────────
(Sin cambios, ver version anterior del documento)

────────────────────────────────────────────────────────
10.8 OFRECIMIENTO DE SERVICIOS (JOBS)  [NUEVO 2026-05-11 sesion 2]
────────────────────────────────────────────────────────

GET /jobs?firebase_uid=xxx
  Retorna: array de jobs con campos agregados:
    id, firebase_uid, nombre, descripcion, nombre_cliente, telefono_cliente,
    monto_total, estado, payment_status, fecha_inicio, fecha_fin, created_at,
    total_recibido (SUM customer_payments),
    total_gastos (SUM operational_expenses),
    total_pagos_colaboradores (SUM team_member_payments)

POST /jobs
  Body: { firebase_uid, nombre, nombre_cliente, telefono_cliente?,
          descripcion?, monto_total, estado?, fecha_inicio?, fecha_fin? }
  Requeridos: firebase_uid, nombre, monto_total
  Retorna: job recien creado
  Efecto: crea registro en job_activity_logs (accion='created')

GET /jobs/:id?firebase_uid=xxx
  Retorna objeto completo:
    {
      job: { ...campos del trabajo },
      teamMembers: [...],
      customerPayments: [...],
      expenses: [...],
      teamPayments: [{ ...pago, nombre_colaborador }],
      resumen: {
        monto_total, total_recibido, saldo_pendiente,
        total_gastos, total_pagos_colaboradores,
        utilidad_neta, margen (%)
      }
    }
  Formula utilidad_neta = total_recibido - total_gastos - total_pagos_colaboradores

PUT /jobs/:id
  Body: { firebase_uid, nombre?, descripcion?, nombre_cliente?,
          telefono_cliente?, monto_total?, estado?, payment_status?,
          fecha_inicio?, fecha_fin? }
  Usa COALESCE para actualizar solo campos enviados
  Si se envia estado: registra en job_activity_logs (accion='status_change')

DELETE /jobs/:id?firebase_uid=xxx
  Elimina trabajo y en cascada todos sus registros relacionados

POST /jobs/:id/team-members
  Body: { firebase_uid, nombre, tipo_compensacion,
          monto_acordado?, porcentaje?, horas_trabajadas?, tarifa_hora? }
  tipo_compensacion ENUM: fijo | porcentual | por_horas | por_tarea | ganancias
  Calcula monto_calculado automaticamente:
    fijo     → monto_acordado
    por_horas → horas_trabajadas × tarifa_hora

DELETE /jobs/:id/team-members/:mid?firebase_uid=xxx

POST /jobs/:id/customer-payments
  Body: { firebase_uid, monto, tipo?, nota? }
  tipo ENUM: anticipo | pago_parcial | pago_final
  Efectos:
    1. Inserta pago en customer_payments
    2. Recalcula payment_status del job:
       recibido >= monto_total → 'paid'
       recibido > 0            → 'partially_paid'
       recibido = 0            → 'pending'
    3. Registra en job_activity_logs (accion='customer_payment')

DELETE /jobs/:id/customer-payments/:pid?firebase_uid=xxx

POST /jobs/:id/expenses
  Body: { firebase_uid, descripcion, monto, categoria? }
  categoria libre: materiales | transporte | equipo | alimentacion | otro
  Registra en job_activity_logs (accion='expense')

DELETE /jobs/:id/expenses/:eid?firebase_uid=xxx

POST /jobs/:id/team-member-payments
  Body: { firebase_uid, team_member_id, monto, nota? }
  Registra en job_activity_logs (accion='team_payment')
  Retorna pago con nombre_colaborador del JOIN

GET /jobs/:id/financial-summary?firebase_uid=xxx
  Retorna resumen financiero puntual del trabajo (igual que resumen en GET /jobs/:id)

